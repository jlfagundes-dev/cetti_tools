# Pasta que contem os documentos a indexar. Use caminho absoluto no Windows.
CETTI_ROOT=C:/Dados/Cetti/Documentos

# Banco SQLite local. Deve ficar fora de CETTI_ROOT e, preferencialmente, fora do OneDrive.
CETTI_DB_PATH=C:/Dados/Cetti/Estado/cetti.sqlite3

# Ollama e modelos locais (opcionais; usados somente com --ollama ou na interface).
CETTI_OLLAMA_URL=http://127.0.0.1:11434
CETTI_TEXT_MODEL=qwen3:4b
CETTI_OCR_MODEL=glm-ocr
# Tempo máximo de geração do modelo, em segundos.
CETTI_OLLAMA_TIMEOUT=300
# O endpoint de disponibilidade deve falhar rapidamente.
CETTI_OLLAMA_STATUS_TIMEOUT=15

# Nome(s) do advogado do escritório; nunca devem ser tratados como cliente.
# Separe múltiplos nomes por vírgula.
ADVOGADO_PADRAO=DR. GENELÚCIO
